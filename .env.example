# Runtime: server-only. Never expose these names with NEXT_PUBLIC_.
DATABASE_URL=postgresql://vs_consultoria:change-me@localhost:5434/vs_consultoria
DATABASE_URL_UNPOOLED=
LOG_LEVEL=info

# Local PostgreSQL container. Compose reads these through env_file.
POSTGRES_DB=vs_consultoria
POSTGRES_USER=vs_consultoria
POSTGRES_PASSWORD=change-me
